{
  "name": "faoc2021-schema-violations",
  "description": "FAoC2021 (Weidmann/Anjorin 2021): Schema-Constraints. NoTwoGlossaries und NoEmptyClass werden durch Engine-Mechanik (Duplikations-Saturation für 7a, Pattern-Strenge für 7b) belegt. SameNameSameGlossaryEntry (7c) wird durch denselben Mechanismus belegt: zwei Methods mit gleichem Namen produzieren denselben GlossaryEntry-Ghost-ID-Hash, Duplikation filtert die zweite.",
  "rules": [
    {
      "name": "DocToGlossary",
      "rank": 30,
      "documentation": "Doc → Glossary. NoTwoGlossaries (7a) ergibt sich durch Duplikations-Saturation: zweite Anwendung produziert gleiche Glossary-Ghost-ID, wird verworfen.",
      "l_pattern": {
        "nodes": [
          { "id": "d", "kind": "Doc", "constraints": [] }
        ],
        "edges": []
      },
      "r_pattern": {
        "nodes": [
          { "id": "d", "kind": "Doc", "constraints": [] },
          { "id": "g", "kind": "Glossary", "constraints": [] }
        ],
        "edges": []
      },
      "correspondence_links": [
        {
          "l_node_id": "d",
          "r_node_id": "g",
          "kind": "CorrDocGlossary",
          "attribute_bindings": [
            { "l_attr_name": "name", "r_attr_name": "name", "transformation": "identity" }
          ]
        }
      ]
    },
    {
      "name": "ClassWithMethodToDoc",
      "rank": 30,
      "documentation": "Class mit ≥1 Method → Doc. NoEmptyClass (7b) durch Pattern-Strenge: leere Classes matchen das L-Pattern nicht, werden nicht übersetzt.",
      "l_pattern": {
        "nodes": [
          { "id": "c", "kind": "Class", "constraints": [] },
          { "id": "m", "kind": "Method", "constraints": [] }
        ],
        "edges": [
          { "kind": "methods", "source_node_id": "c", "target_node_id": "m" }
        ]
      },
      "r_pattern": {
        "nodes": [
          { "id": "c", "kind": "Class", "constraints": [] },
          { "id": "m", "kind": "Method", "constraints": [] },
          { "id": "d", "kind": "Doc", "constraints": [] }
        ],
        "edges": []
      },
      "correspondence_links": [
        {
          "l_node_id": "c",
          "r_node_id": "d",
          "kind": "CorrClass",
          "attribute_bindings": [
            { "l_attr_name": "name", "r_attr_name": "name", "transformation": "identity" }
          ]
        }
      ]
    },
    {
      "name": "MethodToGlossaryEntry",
      "rank": 20,
      "documentation": "Method m unter Class c (Context-Corr c↔d). R: GlossaryEntry ge + CorrMethodEntry. SameNameSameGlossaryEntry (7c) durch Duplikations-Saturation: zwei Methods mit gleichem name produzieren GlossaryEntry mit identischer Ghost-ID, Duplikat-Filter verhindert Mehrfach-Erzeugung.",
      "l_pattern": {
        "nodes": [
          { "id": "c", "kind": "Class", "constraints": [] },
          { "id": "m", "kind": "Method", "constraints": [] }
        ],
        "edges": [
          { "kind": "methods", "source_node_id": "c", "target_node_id": "m" }
        ]
      },
      "r_pattern": {
        "nodes": [
          { "id": "c", "kind": "Class", "constraints": [] },
          { "id": "m", "kind": "Method", "constraints": [] },
          { "id": "d", "kind": "Doc", "constraints": [] },
          { "id": "ge", "kind": "GlossaryEntry", "constraints": [] }
        ],
        "edges": []
      },
      "correspondence_links": [
        {
          "l_node_id": "c",
          "r_node_id": "d",
          "kind": "CorrClass",
          "attribute_bindings": []
        },
        {
          "l_node_id": "m",
          "r_node_id": "ge",
          "kind": "CorrMethodEntry",
          "attribute_bindings": [
            { "l_attr_name": "name", "r_attr_name": "name", "transformation": "identity" }
          ]
        }
      ]
    }
  ]
}
