{
  "name": "sle2020-class-doc",
  "description": "SLE2020-Class↔Doc-TGG (Fritsche et al. 2020 Fig. 3, vereinfacht). 2 Rules: ClassToDoc, MethodToEntry.",
  "rules": [
    {
      "name": "ClassToDoc",
      "rank": 30,
      "documentation": "L: Class c. R: Doc d + CorrClass(c↔d, name↦name).",
      "l_pattern": {
        "nodes": [
          { "id": "c", "kind": "Class", "constraints": [] }
        ],
        "edges": []
      },
      "r_pattern": {
        "nodes": [
          { "id": "c", "kind": "Class", "constraints": [] },
          { "id": "d", "kind": "Doc", "constraints": [] }
        ],
        "edges": []
      },
      "correspondence_links": [
        {
          "l_node_id": "c",
          "r_node_id": "d",
          "kind": "CorrClass",
          "attribute_bindings": [
            { "l_attr_name": "name", "r_attr_name": "name", "transformation": "identity" }
          ]
        }
      ]
    },
    {
      "name": "MethodToEntry",
      "rank": 20,
      "documentation": "L: Method m unter Class c (Context-Corr c↔d). R: Entry e + CorrMethod(m↔e, name↦name).",
      "l_pattern": {
        "nodes": [
          { "id": "c", "kind": "Class", "constraints": [] },
          { "id": "m", "kind": "Method", "constraints": [] }
        ],
        "edges": [
          { "kind": "methods", "source_node_id": "c", "target_node_id": "m" }
        ]
      },
      "r_pattern": {
        "nodes": [
          { "id": "c", "kind": "Class", "constraints": [] },
          { "id": "m", "kind": "Method", "constraints": [] },
          { "id": "d", "kind": "Doc", "constraints": [] },
          { "id": "e", "kind": "Entry", "constraints": [] }
        ],
        "edges": []
      },
      "correspondence_links": [
        {
          "l_node_id": "c",
          "r_node_id": "d",
          "kind": "CorrClass",
          "attribute_bindings": []
        },
        {
          "l_node_id": "m",
          "r_node_id": "e",
          "kind": "CorrMethod",
          "attribute_bindings": [
            { "l_attr_name": "name", "r_attr_name": "name", "transformation": "identity" }
          ]
        }
      ]
    }
  ]
}
