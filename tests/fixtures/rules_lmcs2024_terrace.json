    {
      "name": "NextRule",
      "rank": 10,
      "documentation": "Sequenz-Propagation: L next(h1→h2) + Context-Corrs auf beide → R nextConstr(c1→c2).",
      "l_pattern": {
        "nodes": [
          { "id": "h1", "kind": "House", "constraints": [] },
          { "id": "h2", "kind": "House", "constraints": [] }
        ],
        "edges": [
          { "kind": "next", "source_node_id": "h1", "target_node_id": "h2" }
        ]
      },
      "r_pattern": {
        "nodes": [
          { "id": "h1", "kind": "House", "constraints": [] },
          { "id": "h2", "kind": "House", "constraints": [] },
          { "id": "c1", "kind": "Construction", "constraints": [] },
          { "id": "c2", "kind": "Construction", "constraints": [] }
        ],
        "edges": [
          { "kind": "nextConstr", "source_node_id": "c1", "target_node_id": "c2" }
        ]
      },
      "correspondence_links": [
        {
          "l_node_id": "h1",
          "r_node_id": "c1",
          "kind": "CorrHouse",
          "attribute_bindings": []
