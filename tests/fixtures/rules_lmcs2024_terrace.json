        },
        {
          "l_node_id": "h",
          "r_node_id": "floor",
          "kind": "CorrFloor",
          "attribute_bindings": [
            { "l_attr_name": "name", "r_attr_name": "name", "transformation": "identity" }
          ]
        },
        {
          "l_node_id": "h",
          "r_node_id": "roof",
