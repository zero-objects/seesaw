{
  "name": "jot2022-sysml-eventb",
  "description": "JOT2022-SysML↔Event-B-TGG (Weidmann et al. 2022 Fig. 4–5). 4 Rules: SMToMachine, StateToEvent, VarToVar, TransToEdge. TransToEdge matcht nur, wenn die Transition source UND target hat — dangling Transitionen werden nicht übersetzt.",
  "rules": [
    {
      "name": "SMToMachine",
      "rank": 40,
      "documentation": "L: Statemachine sm. R: Machine m + CorrSM(sm↔m, name↦name).",
      "l_pattern": {
        "nodes": [
          { "id": "sm", "kind": "Statemachine", "constraints": [] }
        ],
        "edges": []
      },
      "r_pattern": {
        "nodes": [
          { "id": "sm", "kind": "Statemachine", "constraints": [] },
          { "id": "m", "kind": "Machine", "constraints": [] }
        ],
        "edges": []
      },
      "correspondence_links": [
        {
          "l_node_id": "sm",
          "r_node_id": "m",
          "kind": "CorrSM",
          "attribute_bindings": [
            { "l_attr_name": "name", "r_attr_name": "name", "transformation": "identity" }
          ]
        }
      ]
    },
    {
      "name": "StateToEvent",
      "rank": 30,
      "documentation": "L: State s unter Statemachine sm (Context-Corr). R: EventBlock e + CorrState(s↔e, name↦name).",
      "l_pattern": {
        "nodes": [
          { "id": "sm", "kind": "Statemachine", "constraints": [] },
          { "id": "s", "kind": "State", "constraints": [] }
        ],
        "edges": [
          { "kind": "states", "source_node_id": "sm", "target_node_id": "s" }
        ]
      },
      "r_pattern": {
        "nodes": [
          { "id": "sm", "kind": "Statemachine", "constraints": [] },
          { "id": "s", "kind": "State", "constraints": [] },
          { "id": "m", "kind": "Machine", "constraints": [] },
          { "id": "e", "kind": "EventBlock", "constraints": [] }
        ],
        "edges": []
      },
      "correspondence_links": [
        {
          "l_node_id": "sm",
          "r_node_id": "m",
          "kind": "CorrSM",
          "attribute_bindings": []
        },
        {
          "l_node_id": "s",
          "r_node_id": "e",
          "kind": "CorrState",
          "attribute_bindings": [
            { "l_attr_name": "name", "r_attr_name": "name", "transformation": "identity" }
          ]
        }
      ]
    },
    {
      "name": "VarToVar",
      "rank": 20,
      "documentation": "L: Variable v unter Statemachine sm (Context-Corr). R: EventVariable ev + CorrVar(v↔ev, name↦name).",
      "l_pattern": {
        "nodes": [
          { "id": "sm", "kind": "Statemachine", "constraints": [] },
          { "id": "v", "kind": "Variable", "constraints": [] }
        ],
        "edges": [
          { "kind": "variables", "source_node_id": "sm", "target_node_id": "v" }
        ]
      },
      "r_pattern": {
        "nodes": [
          { "id": "sm", "kind": "Statemachine", "constraints": [] },
          { "id": "v", "kind": "Variable", "constraints": [] },
          { "id": "m", "kind": "Machine", "constraints": [] },
          { "id": "ev", "kind": "EventVariable", "constraints": [] }
        ],
        "edges": []
      },
      "correspondence_links": [
        {
          "l_node_id": "sm",
          "r_node_id": "m",
          "kind": "CorrSM",
          "attribute_bindings": []
        },
        {
          "l_node_id": "v",
          "r_node_id": "ev",
          "kind": "CorrVar",
          "attribute_bindings": [
            { "l_attr_name": "name", "r_attr_name": "name", "transformation": "identity" }
          ]
        }
      ]
    },
    {
      "name": "TransToEdge",
      "rank": 10,
      "documentation": "L: Transition t mit source-Edge zu State src und target-Edge zu State tgt; Context-Corrs auf src↔srcEvent und tgt↔tgtEvent. R: MachineEdge me + CorrTrans(t↔me, name↦name). Matcht NICHT, wenn t keine target-Edge hat (dangling Transition wird übersprungen).",
      "l_pattern": {
        "nodes": [
          { "id": "t", "kind": "Transition", "constraints": [] },
          { "id": "src", "kind": "State", "constraints": [] },
          { "id": "tgt", "kind": "State", "constraints": [] }
        ],
        "edges": [
          { "kind": "source", "source_node_id": "t", "target_node_id": "src" },
          { "kind": "target", "source_node_id": "t", "target_node_id": "tgt" }
        ]
      },
      "r_pattern": {
        "nodes": [
          { "id": "t", "kind": "Transition", "constraints": [] },
          { "id": "src", "kind": "State", "constraints": [] },
          { "id": "tgt", "kind": "State", "constraints": [] },
          { "id": "srcEvent", "kind": "EventBlock", "constraints": [] },
          { "id": "tgtEvent", "kind": "EventBlock", "constraints": [] },
          { "id": "me", "kind": "MachineEdge", "constraints": [] }
        ],
        "edges": []
      },
      "correspondence_links": [
        {
          "l_node_id": "src",
          "r_node_id": "srcEvent",
          "kind": "CorrState",
          "attribute_bindings": []
        },
        {
          "l_node_id": "tgt",
          "r_node_id": "tgtEvent",
          "kind": "CorrState",
          "attribute_bindings": []
        },
        {
          "l_node_id": "t",
          "r_node_id": "me",
          "kind": "CorrTrans",
          "attribute_bindings": [
            { "l_attr_name": "name", "r_attr_name": "name", "transformation": "identity" }
          ]
        }
      ]
    }
  ]
}
